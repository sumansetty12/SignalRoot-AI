# Default is SAFE: AWS access disabled; synthetic demo available at /api/aws/demo.
SIGNALROOT_AWS_ENABLED=0
SIGNALROOT_AWS_REGION=us-east-1
# Use your configured AWS CLI profile (no keys in project):
# AWS_PROFILE=signalroot-sandbox
# Optional cross-account IAM role; requires preconfigured credential source:
# SIGNALROOT_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/SignalRootReadOnly
# SIGNALROOT_AWS_EXTERNAL_ID=unique-long-external-id
# Optional AI access from v0.4.0 remains independent. Never paste AWS secrets in the dashboard.
