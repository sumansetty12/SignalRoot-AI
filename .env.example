# Default is SAFE: AWS access disabled; synthetic demo available at /api/aws/demo.
SIGNALROOT_AWS_ENABLED=0
SIGNALROOT_AWS_REGION=us-east-1
# Use your configured AWS CLI profile (no keys in project):
# AWS_PROFILE=signalroot-sandbox
# Optional cross-account IAM role; requires preconfigured credential source:
# SIGNALROOT_AWS_ROLE_ARN=arn:aws:iam::123456789012:role/SignalRootReadOnly
# SIGNALROOT_AWS_EXTERNAL_ID=unique-long-external-id
# Optional AI access from v0.4.0 remains independent. Never paste AWS secrets in the dashboard.

# Optional live AI for AWS window analysis; off by default and may incur API charges.
SIGNALROOT_AWS_AI_ENABLED=0
# OPENAI_API_KEY= (set in your terminal only, never commit)
# SIGNALROOT_MODEL= (optional)
# Optional /signalroot-lab/ CloudWatch log groups, up to 3; raw content never returned.
# SIGNALROOT_LOG_GROUPS=/signalroot-lab/app

# v0.9.0: opt-in single-account background polling
SIGNALROOT_AUTO_MONITOR=0
SIGNALROOT_POLL_SECONDS=300
SIGNALROOT_AUTO_AI_ENABLED=0
SIGNALROOT_DAILY_AI_LIMIT=0
# SIGNALROOT_WEBHOOK_URL= (HTTPS trusted webhook; keep secret)
# SIGNALROOT_DB_PATH= (optional private filesystem path)
